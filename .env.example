# Copie este arquivo para .env e preencha as credenciais da sua aplicação Pluggy.
# Nunca compartilhe o Client Secret ou coloque-o em arquivos do navegador.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_INCLUDE_SANDBOX=true
PORT=4173

# Configuração da hospedagem e login restrito ao Google (segredos ficam nas variáveis do provedor).
NODE_ENV=production
HOST=0.0.0.0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GESTORPRO_ALLOWED_GOOGLE_EMAIL=ruandiasmaiasilva@gmail.com
